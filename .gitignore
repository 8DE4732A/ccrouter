# Build artifacts
/ccrouter
/tmp/
*.test

# Cross-compiled release binaries
/dist/

# Frontend build output — generated by `make web` / `go generate ./...`
# The entire dist/ tree is gitignored; CI always runs `make web` before `go build`.
/internal/server/web/dist/
/web/node_modules/

# Local runtime data (contains plaintext API keys / request logs)
/logs/
*.db
*.db-wal
*.db-shm

# Local config — contains real API keys, never commit
config.yaml
config.local.yaml
.env
.env.*

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Claude Code
.claude